# Copy to .env and adjust. .env is gitignored.
#
# Keep the `export` on every line. A plain `source .env` must reach child
# processes; without it the variable stays inside the shell.
#
# ODAS reads two environment variables and nothing else. Branding, the identity
# provider, the mail relay, the log level, the listen port and the types of zaak
# are all declared in $ODAS_DATA_DIR/.app/config.yaml, which the data dir owns.
# Credentials go in $ODAS_DATA_DIR/.app/secrets.yaml, mode 0600.
#
# Run `odas init` to give a new data dir both files, then `odas config check`.
#
# You do not need this file for local work. `./start_dev.sh` puts a copy of the
# example data in /tmp/odas-dev and points ODAS_DATA_DIR at it, so the repo
# stays clean.

# The data dir to develop against. `inv check` reads it.
export ODAS_DATA_DIR=~/data/odas

# Only scripts/get_data.sh reads this one: an rsync source, the live volume.
# export DEV_REMOTE=my-vps:/srv/data/odas

# Only `inv deploy` reads the two below. The app never does.
# export ODAS_DEPLOY_VPS=my-vps            # ssh alias
# export ODAS_DEPLOY_STACK=/srv/stack      # the compose dir on the VPS

# ODAS_TEST_MODE=1 bypasses auth for local development only (set by start_dev.sh).
# NEVER set it in production.
